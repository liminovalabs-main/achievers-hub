{
  "name": "achievers-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @achievers-hub/web dev",
    "dev:api": "pnpm --filter @achievers-hub/api dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @achievers-hub/database generate",
    "db:migrate": "pnpm --filter @achievers-hub/database migrate",
    "db:seed": "pnpm --filter @achievers-hub/database seed"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "^5.9.3"
  }
}
